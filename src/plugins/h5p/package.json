{
  "name": "strapi-plugin-h5p",
  "version": "1.0.0",
  "description": "H5P plugin for Strapi - Interactive content editor",
  "strapi": {
    "name": "h5p",
    "displayName": "H5P",
    "description": "Create and manage interactive H5P content",
    "kind": "plugin"
  },
  "exports": {
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.tsx",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@lumieducation/h5p-server": "^10.0.4",
    "@lumieducation/h5p-express": "^10.0.0",
    "@lumieducation/h5p-html-exporter": "^10.0.0",
    "axios": "^1.6.0",
    "fs-extra": "^11.1.1"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0"
  },
  "author": {
    "name": "Strapi Solutions"
  },
  "maintainers": [
    {
      "name": "Strapi Solutions"
    }
  ],
  "engines": {
    "node": ">=18.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  },
  "license": "MIT"
}
